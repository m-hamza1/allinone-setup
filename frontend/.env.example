# Laravel API (include /api suffix)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Demo website widget token (from DatabaseSeeder)
NEXT_PUBLIC_WIDGET_TOKEN=demo-widget-token-change-me

# Optional Reverb / Echo (staff inbox falls back to polling without these)
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
